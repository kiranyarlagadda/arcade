{
  "name": "arcade",
  "version": "0.3.0",
  "description": "Browser games I built from scratch, each one a drop-in custom element: <arcade-game name=\"aim\">",
  "type": "module",
  "license": "MIT",
  "author": "Kiran Yarlagadda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiranyarlagadda/arcade.git"
  },
  "keywords": [
    "canvas",
    "games",
    "web-components",
    "custom-elements"
  ],
  "exports": {
    ".": "./src/index.js",
    "./games/*": "./src/games/*.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/arcade-game.js"
  ],
  "scripts": {
    "dev": "vite --port 5181",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "^18.0.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
